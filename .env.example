# iTrakHelper Konfiguration
# Kopiere diese Datei zu ".env" und trage deine echten Werte ein.
# Die .env-Datei wird von git ignoriert und darf NICHT committet werden.

# URL der iTrak Controller-Seite (interne Adresse — hier deine eigene eintragen)
iTrak_CONTROLLER_URL=https://<dein-itrak-host>/online/inbound/controller

# Login-Zugangsdaten
iTrak_ACCESS_CODE=dein_access_code
iTrak_USERNAME=dein_username
iTrak_PASSWORD=dein_passwort
